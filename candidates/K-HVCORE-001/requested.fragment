# Error-directed Hyper-V execution-core addition after K-MKROOT-001 reached B0.
# Explicit additions:
CONFIG_HYPERVISOR_GUEST=y
CONFIG_HYPERV=y

# Preserve the mkroot/Stage-1 values for unrelated hypervisor defaults exposed
